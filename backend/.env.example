PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/e-commerce
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:4321,http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
PUBLIC_API_URL=http://localhost:4000
PUBLIC_STOREFRONT_URL=http://localhost:4321

# Stripe uses hosted Checkout so this backend never handles card numbers.
# Use test-mode keys while developing; set the webhook secret from Stripe CLI
# or the configured Stripe webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_SHIPPING_COUNTRIES=US,KE,GB
STRIPE_SHIPPING_AMOUNT_CENTS=
STRIPE_SHIPPING_LABEL=

# Create an API key in your CJ account. It is only read by the backend.
CJ_API_KEY=

# Optional Firebase Admin service-account JSON encoded as one base64 line.
# Keep this backend-only; the PUBLIC_FIREBASE_* web config belongs in frontend/.env.
FIREBASE_SERVICE_ACCOUNT_BASE64=
